static void EjercicioP() 
{ 
string[] opciones = { "piedra", "papel", "tijera" }; 
int victoriasUsuario = 0; int victoriasCPU = 0; 
for (int i = 1; i <= 3; i++) 
{ 
Console.WriteLine($"\n--- RONDA {i} ---");  
Console.Write("Elija piedra, papel o tijera: "); 
string eleccionUsuario = Console.ReadLine().ToLower();
string eleccionCPU = opciones[rnd.Next(0, 3)];
Console.WriteLine($"La CPU eligió: {eleccionCPU}"); 
if (eleccionUsuario == eleccionCPU) 
{ 
Console.WriteLine("Empate en esta ronda.");
} 
else if ((eleccionUsuario == "piedra" && eleccionCPU == "tijera") || (eleccionUsuario == "papel" && eleccionCPU == "piedra") || (eleccionUsuario == "tijera" && eleccionCPU == "papel")) 
{ 
Console.WriteLine("¡Ganaste esta ronda!"); victoriasUsuario++; 
}
else 
{ 
Console.WriteLine("La CPU gana esta ronda."); 
victoriasCPU++; 
} 
} 
Console.WriteLine("RESULTADO FINAL"); 
if (victoriasUsuario > victoriasCPU) Console.WriteLine("Ganaste"); 
else if (victoriasCPU > victoriasUsuario) 
Console.WriteLine("Ganó la CPU."); 
else Console.WriteLine("El juego terminó en empate."); 
} 

